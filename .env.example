# notebook_runner — required secrets
# Copy this file to .env and fill in the values.
# Never commit .env to git. chmod 600 it.
#
# QUOTE EVERY VALUE. python-dotenv (used by run.py) tolerates bare values, but
# docker/run-ci.sh `source`s this file so the Claude CLI inherits the vars, and
# bash chokes on values containing spaces or brackets: an unquoted
# `Ocp-Apim-Subscription-Key: <key>` parses as a command plus argument, and
# `Claude-Sonnet-5[1m]` is a glob. Both readers accept quotes.

# ── Claude ────────────────────────────────────────────────────────────────
# On the AMD network the agent authenticates through the enterprise gateway,
# NOT with a first-party Anthropic key:
#
#   ANTHROPIC_API_KEY        must be non-empty or the CLI refuses to start;
#                            the gateway ignores the value, so "dummy" is right
#   ANTHROPIC_BASE_URL       gateway endpoint — without it the CLI calls
#                            api.anthropic.com and gets 401
#   ANTHROPIC_CUSTOM_HEADERS the APIM subscription header — the real secret
#
# Off the AMD network: set ANTHROPIC_API_KEY to a real sk-ant-... key and leave
# the two gateway variables empty.
#
# Note `claude auth status` reports loggedIn for ANY non-empty key — it does
# not validate. Only a real request proves credentials work.
ANTHROPIC_API_KEY="dummy"
ANTHROPIC_BASE_URL="https://llm-api.amd.com/Unified"
ANTHROPIC_CUSTOM_HEADERS="Ocp-Apim-Subscription-Key: <your-apim-subscription-key>"

# Gateway-side model names — the public model IDs are not valid here.
ANTHROPIC_MODEL="Claude-Sonnet-5[1m]"
ANTHROPIC_DEFAULT_OPUS_MODEL="Claude-Opus-5[1m]"
ANTHROPIC_DEFAULT_SONNET_MODEL="Claude-Sonnet-5[1m]"
ANTHROPIC_DEFAULT_HAIKU_MODEL="Claude-Haiku-4.5"

# ── GPU server ────────────────────────────────────────────────────────────
# Hostname or IP of the AMD GPU server, and the SSH user (needs Docker access).
GPU_HOST=""
GPU_USER=""

# Dedicated application keypair — NOT a personal key. Only used when real SSH
# to the GPU node works (AGENT_URL/AGENT_SECRET below are unset). This key is
# mounted into a container that runs model-authored shell commands, so it
# should unlock exactly one host and revoke with one authorized_keys line:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_nbrunner_ed25519 -N '' -C notebook-runner-ci
#   ssh-copy-id -i ~/.ssh/id_nbrunner_ed25519.pub <user>@<gpu-host>
GPU_SSH_KEY="$HOME/.ssh/id_nbrunner_ed25519"

# ── HTTP transport shim (when real SSH to the GPU node doesn't work) ─────
# On the current deployment, AMD's egress silently drops SSH (and refuses
# TLS outright) to this node's IP range — plain HTTP on :80 is the only
# transport that passes cleanly. See docs/PLAN-http-agent-shim.md and
# tools/http_ssh_shim/. When both of these are set, run.py prepends
# tools/http_ssh_shim/ to PATH so every `ssh`/`scp` invocation (from
# run.py, tools/env_check.py, docker/run-ci.sh, and the Claude Code
# agent's own autonomous Bash-tool usage) transparently goes over HTTP
# instead — no other code changes required. Leave both empty to use real
# SSH (GPU_SSH_KEY above) when that's actually reachable.
#
# AGENT_SECRET is a shared HMAC signing key (never transmitted itself —
# only per-request signatures are, since this link carries no TLS
# confidentiality). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# and place the identical value in /etc/notebook-runner-agent.env on the
# GPU node (read by the agent-server.service systemd unit — see
# tools/http_ssh_shim/agent-server.service).
AGENT_URL=""
AGENT_SECRET=""

# ── Teams reporting (optional) ────────────────────────────────────────────
# Power Automate ("Workflows") webhook, not a legacy Office 365 connector —
# the payload schemas differ and connectors are retired.
# This URL is a bearer credential: the `sig=` parameter authorizes posting.
# Leave empty to disable notifications; the pass still runs.
TEAMS_WEBHOOK_URL=""

# ── HuggingFace ───────────────────────────────────────────────────────────
# Required for gated model downloads (meta-llama, mistralai, ...).
# tools/env_check.py fails those notebooks early without it.
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=""
