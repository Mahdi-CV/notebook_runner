# notebook_runner — required secrets
# Copy this file to .env and fill in the values.
# Never commit .env to git. chmod 600 it.
#
# Quote every value: docker/run-ci.sh `source`s this file, and bash misparses
# unquoted values with spaces or brackets.

# ── Claude ────────────────────────────────────────────────────────────────
# On the AMD network the agent authenticates through the enterprise gateway:
#   ANTHROPIC_API_KEY        must be non-empty; the gateway ignores it ("dummy")
#   ANTHROPIC_BASE_URL       gateway endpoint (without it: api.anthropic.com, 401)
#   ANTHROPIC_CUSTOM_HEADERS the APIM subscription header — the real secret
# Off the AMD network: set a real sk-ant-... key and leave the other two empty.
ANTHROPIC_API_KEY="dummy"
ANTHROPIC_BASE_URL="https://llm-api.amd.com/Unified"
ANTHROPIC_CUSTOM_HEADERS="Ocp-Apim-Subscription-Key: <your-apim-subscription-key>"

# Gateway-side model names — the public model IDs are not valid here.
ANTHROPIC_MODEL="Claude-Sonnet-5[1m]"
ANTHROPIC_DEFAULT_OPUS_MODEL="Claude-Opus-5[1m]"
ANTHROPIC_DEFAULT_SONNET_MODEL="Claude-Sonnet-5[1m]"
ANTHROPIC_DEFAULT_HAIKU_MODEL="Claude-Haiku-4.5"

# Targets (GPU hosts and k8s pools) are described in runner.yaml, not here.

# ── HTTP transport shim (optional) ────────────────────────────────────────
# Signs requests to runner.yaml targets that have an agent_url (reached through
# tools/http_ssh_shim/). It is an HMAC key, never sent itself. Generate with
# `python3 -c "import secrets; print(secrets.token_hex(32))"` and put the same
# value in /etc/notebook-runner-agent.env on each such GPU node.
AGENT_SECRET=""

# ── Radeon Global runner (optional) ──────────────────────────────────────
# Bearer token for the Radeon Global Service API, used by runner.yaml targets
# with `type: radeon` (tools/radeon_pod.py).
RADEON_CLOUD_API_TOKEN=""

# ── Notebooks under test (optional) ───────────────────────────────────────
# docker/run-ci.sh tests this repository's tip each pass.
# NBR_NOTEBOOKS_REPO="https://github.com/ROCm/gpuaidev.git"
# NBR_NOTEBOOKS_REF="main"
# NBR_NOTEBOOKS_SUBDIR="docs/notebooks"

# ── Kubernetes runner (optional) ──────────────────────────────────────────
# Namespace-scoped ServiceAccount kubeconfig for runner.yaml's k8s targets.
# Mint it with `python3 tools/k8s_pod.py --target <k8s target> kubeconfig` after
# applying tools/k8s/rbac.yaml. Never an admin kubeconfig: the agent can read
# whatever credential the runner holds.
NBR_KUBECONFIG=""

# ── Teams reporting (optional) ────────────────────────────────────────────
# Power Automate ("Workflows") webhook. The URL is a bearer credential.
# Leave empty to disable notifications; the pass still runs.
TEAMS_WEBHOOK_URL=""

# ── HuggingFace ───────────────────────────────────────────────────────────
# Required for gated model downloads (meta-llama, mistralai, ...).
# tools/env_check.py fails those notebooks early without it.
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=""
