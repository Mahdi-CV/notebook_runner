[Unit]
Description=notebook-runner read-only results dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/notebook_runner
Environment=NBR_ROOT=/data/notebook_runner
# Serve the authoring service (docker/run-authoring-web.sh, 127.0.0.1:8081) under
# /authoring/ on this port. The dashboard only relays requests to it.
Environment=NBR_AUTHORING_UPSTREAM=http://127.0.0.1:8081
# Caddy (dashboard/Caddyfile) serves it on port 80; it listens on 127.0.0.1 only.
ExecStart=/data/notebook_runner/.venv-dashboard/bin/uvicorn dashboard.app:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
# Read-only by design: the app opens results/runs.db with a read-only URI and
# serves GET routes only. It runs as nobody, which owns nothing, and
# ProtectSystem=strict makes every filesystem read-only for this service.
User=nobody
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
