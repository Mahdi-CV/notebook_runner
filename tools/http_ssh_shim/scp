#!/usr/bin/env python3
"""
Drop-in `scp` replacement, paired with the `ssh` shim. Supports the two shapes
this pipeline uses, both carried over the agent server's exec endpoint:

  scp [flags] <local> [<local> ...] user@host:/remote/dir/   (upload)
  scp [flags] user@host:/remote/file /local/file              (download)
"""

import base64
import os
import shlex
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from client import exec_remote, fail, parse_argv


def remote_path(spec: str) -> str | None:
    """Return the path of a user@host:/path spec, or None for a local path."""
    target, sep, path = spec.partition(":")
    return path if sep and "@" in target else None


def run(cmd: str, stdin: bytes = b"") -> str:
    result = exec_remote("scp", cmd, stdin)
    if result["exit_code"] != 0:
        fail("scp", result["stderr"].strip() or f"remote exit {result['exit_code']}", 1)
    return result["stdout"]


def main() -> None:
    args = parse_argv("scp", sys.argv[1:], ("-o", "-i", "-P"))
    if len(args) < 2:
        fail("scp", "expected at least one source and one destination", 1)
    *sources, dest = args

    remote_dir = remote_path(dest)
    if remote_dir is not None:
        for src in sources:
            local = Path(src)
            if remote_path(src) is not None or not local.is_file():
                fail("scp", f"not a local file: {src}", 1)
            target = remote_dir.rstrip("/") + "/" + local.name
            run(f"mkdir -p {shlex.quote(remote_dir)} && cat > {shlex.quote(target)}",
                local.read_bytes())
        return

    if len(sources) != 1 or remote_path(sources[0]) is None:
        fail("scp", "download needs exactly one remote (user@host:path) source", 1)
    data = base64.b64decode(run(f"base64 -w0 {shlex.quote(remote_path(sources[0]))}"))
    Path(dest).parent.mkdir(parents=True, exist_ok=True)
    Path(dest).write_bytes(data)


if __name__ == "__main__":
    main()
