#!/usr/bin/env python3
"""
Drop-in `ssh` replacement: `ssh [flags] user@host 'cmd'` runs `cmd` on the GPU
node through the agent server instead of a real SSH connection. run.py puts
this directory first on PATH, so its SSH_CMD strings and the agent's own
`ssh ...` calls work unmodified. Interactive sessions are not supported.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from client import exec_remote, fail, parse_argv


def main() -> None:
    args = parse_argv("ssh", sys.argv[1:], ("-o", "-i", "-p", "-l"))
    if not args:
        fail("ssh", "no target host given")
    if len(args) < 2:
        fail("ssh", "interactive ssh (no remote command) is not supported by the http shim")
    # Like real ssh, remaining arguments are joined into one remote command.
    result = exec_remote("ssh", " ".join(args[1:]))
    sys.stdout.write(result["stdout"])
    sys.stderr.write(result["stderr"])
    sys.exit(result["exit_code"])


if __name__ == "__main__":
    main()
